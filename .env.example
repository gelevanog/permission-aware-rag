# Copy to .env and adjust. Every variable is optional; the defaults below run the demo fully offline.
# Keys stay out of the repository: put them in .env (gitignored) or your secret manager.

# ---------------------------------------------------------------------------------------------------------
# Database (PostgreSQL 16+ with pgvector 0.8+)
# ---------------------------------------------------------------------------------------------------------
CLEARANCE_DATABASE_URL=postgresql+psycopg://clearance:clearance@localhost:5432/clearance
# Non-owner role every search runs as (SET LOCAL ROLE), so row-level security applies. Created by the migrations.
CLEARANCE_READER_ROLE=clearance_reader
# Run Alembic migrations on API startup.
CLEARANCE_AUTO_MIGRATE=true
# Index the demo corpus (data/company) on API startup when the database has no documents.
CLEARANCE_SEED_DEMO=true
CLEARANCE_CORPUS_DIR=data/company
CLEARANCE_DIRECTORY_FILE=data/directory.yaml
# pgvector iterative index scans keep walking the HNSW index until k *permitted* rows are found: off | strict_order | relaxed_order
CLEARANCE_HNSW_ITERATIVE_SCAN=strict_order

# ---------------------------------------------------------------------------------------------------------
# Embeddings (local, CPU)
# ---------------------------------------------------------------------------------------------------------
# fastembed (ONNX, downloaded once into the model cache) | hash (deterministic, for tests only)
CLEARANCE_EMBEDDING_PROVIDER=fastembed
# Any 384-dimension fastembed model (the vector column is 384-d; other sizes need a migration).
CLEARANCE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CLEARANCE_EMBEDDING_THREADS=4
CLEARANCE_MODEL_CACHE_DIR=.cache/models

# ---------------------------------------------------------------------------------------------------------
# Answer generation
# ---------------------------------------------------------------------------------------------------------
# ollama (default, local) | openai_compatible (vLLM, LM Studio, llama.cpp server) | extractive (no LLM: quotes
# passages) | openrouter | openai | anthropic (cloud: refused unless CLEARANCE_LOCAL_ONLY=false)
CLEARANCE_LLM_PROVIDER=ollama
# Empty = provider default (ollama: qwen3.5:4b, openrouter: nvidia/nemotron-3-ultra-550b-a55b:free,
# openai: gpt-5-mini, anthropic: claude-sonnet-5).
CLEARANCE_LLM_MODEL=
# Ollama or OpenAI-compatible server URL.
CLEARANCE_LLM_BASE_URL=http://localhost:11434/v1
# Bearer token for an openai_compatible server that needs one.
# CLEARANCE_LLM_API_KEY=
# OpenRouter fallback list (comma-separated), sent as `models` so OpenRouter can switch when one is overloaded.
CLEARANCE_LLM_FALLBACK_MODELS=
# If the local model server is unreachable, answer by quoting passages (labelled in the UI) instead of failing.
CLEARANCE_LLM_FALLBACK_TO_EXTRACTIVE=true
CLEARANCE_LLM_TIMEOUT_SECONDS=180
CLEARANCE_LLM_MAX_TOKENS=700
CLEARANCE_LLM_TEMPERATURE=0
# Refuse every cloud provider and any OpenAI-compatible URL that is not this machine or a private network.
CLEARANCE_LOCAL_ONLY=true
# Extra host names that count as yours for the local-only check (comma-separated), e.g. llm.corp.example.com
CLEARANCE_LOCAL_ALLOWED_HOSTS=
# Refuse any OpenRouter model id that does not end in ":free" (and reject answers served by a paid model).
CLEARANCE_REQUIRE_FREE_MODELS=true
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------------------------------------
# Retrieval and answers
# ---------------------------------------------------------------------------------------------------------
CLEARANCE_TOP_K=5
# Chunks below this cosine similarity are not given to the model.
CLEARANCE_MIN_SCORE=0.5
# What the assistant says when nothing the user may read answers the question:
# generic = the message only; contact = the message plus CLEARANCE_CONTACT_MESSAGE. Neither depends on whether a
# restricted document matched, so the reply never confirms that one exists.
CLEARANCE_NO_ANSWER_POLICY=generic
CLEARANCE_NO_ANSWER_MESSAGE=I couldn't find that in documents available to you.
CLEARANCE_CONTACT_MESSAGE=If you think you should have access to more documents on this topic, ask your manager or the IT help desk.

# ---------------------------------------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------------------------------------
# dev = the built-in demo IdP (never in production) | oidc = your identity provider
CLEARANCE_AUTH_MODE=dev
CLEARANCE_DEV_IDP_ENABLED=true
CLEARANCE_DEV_IDP_ISSUER=http://localhost:8000/dev-idp
CLEARANCE_DEV_IDP_KEY_FILE=.cache/dev-idp/signing-key.pem
CLEARANCE_TOKEN_TTL_SECONDS=28800
# For CLEARANCE_AUTH_MODE=oidc (see README > Plug in your identity provider):
# CLEARANCE_OIDC_ISSUER=https://your-org.okta.com/oauth2/default
CLEARANCE_OIDC_AUDIENCE=clearance
# Empty = read jwks_uri from {issuer}/.well-known/openid-configuration
CLEARANCE_OIDC_JWKS_URL=
CLEARANCE_OIDC_ALGORITHMS=RS256
CLEARANCE_GROUPS_CLAIM=groups
CLEARANCE_EMAIL_CLAIM=email
CLEARANCE_GROUP_MAPPING_FILE=configs/group-mapping.yaml
# ignore = groups not in the mapping grant nothing | passthrough = they become group:<name>
CLEARANCE_UNMAPPED_GROUPS=ignore
# Principals allowed to manage ACLs and read the audit log (comma-separated).
CLEARANCE_ADMIN_PRINCIPALS=group:it-admins

# ---------------------------------------------------------------------------------------------------------
# Connectors (only for `clearance sync gdrive|sharepoint`)
# ---------------------------------------------------------------------------------------------------------
# CLEARANCE_GDRIVE_FOLDER_ID=
# CLEARANCE_GDRIVE_SERVICE_ACCOUNT_FILE=/secrets/drive-sa.json
# CLEARANCE_GDRIVE_SUBJECT=admin@your-domain.com
# CLEARANCE_SHAREPOINT_TENANT_ID=
# CLEARANCE_SHAREPOINT_CLIENT_ID=
# CLEARANCE_SHAREPOINT_CLIENT_SECRET=
# CLEARANCE_SHAREPOINT_SITE_ID=
# CLEARANCE_SHAREPOINT_DRIVE_ID=
# CLEARANCE_SHAREPOINT_ORGANIZATION_DOMAIN=your-domain.com

# ---------------------------------------------------------------------------------------------------------
# Cache, audit, trace
# ---------------------------------------------------------------------------------------------------------
CLEARANCE_CACHE_ENABLED=true
CLEARANCE_CACHE_MAX_ENTRIES=2000
CLEARANCE_CACHE_TTL_SECONDS=600
# Secret for the keyed question hash in the audit log. Empty = random per process (hashes not comparable across restarts).
CLEARANCE_AUDIT_KEY=
# Record in the admin-only audit log how many of the nearest candidates the user's permissions excluded.
CLEARANCE_AUDIT_EXCLUDED_COUNTS=true
# Show users how many documents they cannot search (a constant per user, never per question).
CLEARANCE_TRACE_SHOW_EXCLUDED_TOTAL=true

# ---------------------------------------------------------------------------------------------------------
# Budget for real cloud calls (evaluation and judge only)
# ---------------------------------------------------------------------------------------------------------
CLEARANCE_LLM_CACHE_DIR=.cache/llm
CLEARANCE_LLM_LEDGER=results/calls.jsonl
CLEARANCE_LLM_MAX_CALLS=300
CLEARANCE_LLM_MIN_SECONDS_BETWEEN_REQUESTS=3.0
CLEARANCE_LLM_MAX_RETRIES=4

# ---------------------------------------------------------------------------------------------------------
# API and logging
# ---------------------------------------------------------------------------------------------------------
CLEARANCE_CORS_ORIGINS=http://localhost:3000
CLEARANCE_RESULTS_DIR=results
LOG_LEVEL=INFO
# console (human-readable) or json
LOG_FORMAT=console

# ---------------------------------------------------------------------------------------------------------
# docker compose only
# ---------------------------------------------------------------------------------------------------------
# API_PORT=8000
# WEB_PORT=3000
# POSTGRES_PASSWORD=clearance
# BAKE_MODELS=false
